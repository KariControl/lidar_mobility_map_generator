<?xml version="1.0"?>
<package format="3">
  <name>lidar_mobility_map_generator</name>
  <version>0.11.0</version>
  <description>ROS 2 backend for LiDAR Mobility Map Generator: beta closed-course Lanelet2 Vector Map generation from LiDAR SLAM map and trajectory results or rosbag2, with alpha Navigation Map export for Nav2.</description>

  <maintainer email="KariControl@users.noreply.github.com">KariControl</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/KariControl/lidar_mobility_map_generator</url>
  <url type="bugtracker">https://github.com/KariControl/lidar_mobility_map_generator/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>action_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>libxml2-utils</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros2run</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xdg-utils</exec_depend>

  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <depend condition="$LMMG_BUILD_AUTOWARE_LANELET_SMOKE == 1">autoware_lanelet2_utils</depend>
  <depend condition="$LMMG_BUILD_AUTOWARE_LANELET_SMOKE == 1">autoware_map_loader</depend>
  <depend condition="$LMMG_BUILD_AUTOWARE_LANELET_SMOKE == 1">autoware_map_msgs</depend>
  <depend condition="$LMMG_BUILD_AUTOWARE_LANELET_SMOKE == 1">lanelet2_core</depend>
  <depend condition="$LMMG_BUILD_AUTOWARE_LANELET_SMOKE == 1">lanelet2_routing</depend>
  <depend condition="$LMMG_BUILD_AUTOWARE_LANELET_SMOKE == 1">lanelet2_traffic_rules</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
