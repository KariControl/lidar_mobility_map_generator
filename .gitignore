# Public repository manifest (fail closed)
#
# `git add .` must select the same surface as tools/audit_public_release.py.
# Everything is ignored first; only reviewed release files are reopened below.
/*

# Reviewed top-level files
!/.gitattributes
!/.gitignore
!/CHANGELOG.rst
!/CMakeLists.txt
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/README_ja.md
!/RELEASING.md
!/SECURITY.md
!/TRADEMARKS.md
!/package.xml

# GitHub Actions CI
!/.github/
/.github/*
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/dependabot.yml
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/bug_report.yml
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/ISSUE_TEMPLATE/feature_request.yml
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml

# Generator configuration
!/config/
/config/*
!/config/glim.yaml
!/config/review.yaml
!/config/rosbag2.yaml

# ROS launch files
!/launch/
/launch/*
!/launch/edit_and_review.launch.py
!/launch/edit_navigation_map.launch.py
!/launch/edit_vector_map.launch.py
!/launch/generate.launch.py
!/launch/generate_and_review.launch.py
!/launch/review.launch.py
!/launch/semantic_editor.launch.py

# RViz configuration
!/rviz/
/rviz/*
!/rviz/review.rviz

# Public documents and reviewed screenshots
!/docs/
/docs/*
!/docs/operator_manual.md
!/docs/operator_manual_ja.md
!/docs/images/
/docs/images/*
